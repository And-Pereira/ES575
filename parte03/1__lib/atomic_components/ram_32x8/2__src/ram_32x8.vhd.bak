LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;
USE IEEE.NUMERIC_STD.ALL;

-- This code is based on the youtube video  'How to implement RAM in VHDL using ModelSim'

ENTITY RAM_32x8 IS
    PORT(
        ADD: IN STD_LOGIC_VECTOR (4 DOWNTO 0); -- Memory Address
        DATA_IN: IN STD_LOGIC_VECTOR (7 DOWNTO 0); -- Input Data
        WR: IN STD_LOGIC; -- Control signal
        CLK: IN STD_LOGIC; -- Clock signal
        DATA_OUT: OUT STD_LOGIC_VECTOR (7 DOWNTO 0) -- Output Data
    );
END ENTITY RAM_32x8;

ARCHITECTURE BEHAVIORAL OF RAM_32x8 IS
    TYPE RAM_ARR IS ARRAY (0 TO 31) OF STD_LOGIC_VECTOR(7 DOWNTO 0);

    SIGNAL RAM_DATA: RAM_ARR :=(
        x"00", x"00", x"00", x"00",
        x"00", x"00", x"00", x"00",
        x"00", x"00", x"00", x"00",
        x"00", x"00", x"00", x"00",
        x"00", x"00", x"00", x"00",
        x"00", x"00", x"00", x"00",
        x"00", x"00", x"00", x"00",
        x"00", x"00", x"00", x"00"
    );

    BEGIN
        PROCESS (CLK) BEGIN
            IF (rising_edge(CLK)) THEN
                IF (WR = '1') THEN
                    RAM_DATA(TO_INTEGER(UNSIGNED (ADD))) <= DATA_IN;
                END IF;
            END IF;

        END PROCESS;

        DATA_OUT <= RAM_DATA(TO_INTEGER(UNSIGNED (ADD)));

END ARCHITECTURE BEHAVIORAL;