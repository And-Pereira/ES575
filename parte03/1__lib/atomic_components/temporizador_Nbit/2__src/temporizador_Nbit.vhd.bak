-- Library declaration
LIBRARY ieee ;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

-- Entity declaration
ENTITY TEMPORIZADOR_NBIT IS
  GENERIC(
    N : natural :=4;
    valMax : natural := 10

  );
  PORT (
    Clk, reset_n, enable : IN STD_LOGIC;
    itsover : OUT STD_LOGIC
  );
END ENTITY TEMPORIZADOR_NBIT;


-- Architecture declaration
ARCHITECTURE RLT OF TEMPORIZADOR_NBIT IS
SIGNAL VALUE : unsigned(N-1 DOWNTO 0);
BEGIN
PROCESS (Clk, reset_n )
  BEGIN
    -- Falling edge
      IF (reset_n = '1' OR enable = '0') THEN
        VALUE <=(OTHERS => '0');
        itsover <= '0';
        
      ELSIF (VALUE = valMax - 1) THEN
        itsover <= '1';
      
      ELSIF falling_edge(Clk) THEN
        IF enable = '1' THEN
          VALUE <= VALUE + 1;
          itsover <= '0';
        END IF;

      END IF;
    
END PROCESS;
Q <= std_logic_vector(VALUE);
END RLT;