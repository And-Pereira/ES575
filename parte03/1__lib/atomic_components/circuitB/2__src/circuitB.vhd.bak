-- Library importing
LIBRARY IEEE;
USE IEEE.std_logic_1164.all;

-- Entity declaration
ENTITY circuitB IS
    --Define I/O
    PORT(
        X; IN std_logic;
        Y: OUT std_logic_vector( 3 DOWNTO 0)

    );

END ENTITY circuitB;


-- Architecture declaration
ARCHITECTURE ARCH_circuitB OF circuitB IS


BEGIN
            
    Y (3 DOWNTO 1) <= "000";
    Y(0) <= X;
            

END ARCHITECTURE ARCH_circuitB;



