-- Library importing
LIBRARY IEEE;
USE IEEE.std_logic_1164.all;


ENTITY tb_circuitB IS
  --TEST BENCH DOES NOT NEED AN ENTITY
    
END ENTITY tb_circuitB;

ARCHITECTURE BEHAVIORAL OF tb_circuitB IS
  --DEFINE MY TESTING COMPONENTS
  COMPONENT CIRCUITB
      -- DEFINE INPUT/OUTPUT
    PORT(
        X: IN std_logic;
        Y: OUT std_logic_vector( 3 DOWNTO 0)

    );
  
  END COMPONENT;
  
  --DEFINE MY TESTING SIGNALS
  SIGNAL R   : std_logic_vector(3 DOWNTO 0);
  SIGNAL X1   : std_logic;
    
  BEGIN
    --INSTANTIATE COMPONENT
    CB: CIRCUITB
    PORT MAP (
      X1,
      R
    );
    
    -- Test process
    process
    begin
        -- Test Case 0: 
        X1 <= '0'
        wait for 10 ns;
        assert (R = "0000") report "Test Case 1 Failed" severity error;

        -- Test Case 1: 
        X1 <= '1'
        wait for 10 ns;
        assert (R = "0001") report "Test Case 1 Failed" severity error;


        -- End of test
        report "All test cases passed!" severity note;
        wait;  -- Wait indefinitely
    end process;

END ARCHITECTURE BEHAVIORAL;