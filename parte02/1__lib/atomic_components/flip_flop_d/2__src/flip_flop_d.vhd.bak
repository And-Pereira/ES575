-- Library declaration
LIBRARY ieee ;
USE ieee.std_logic_1164.all ;

-- Entity declaration
ENTITY FLIP_FLOP_D IS
  GENERIC(
    N: INTEGER :=4 -- 4 AS DEFAULT VALUE

  );
  PORT (
    Clk : IN STD_LOGIC;
    RST: IN STD_LOGIC;
    D : IN STD_LOGIC_VECTOR (N DOWNTO 0);
    Q : OUT STD_LOGIC_VECTOR (N DOWNTO 0)
  );
END ENTITY FLIP_FLOP_D;


-- Architecture declaration
ARCHITECTURE BEHAVIOR OF FLIP_FLOP_D IS
BEGIN
PROCESS (D, Clk, RST)
  BEGIN
    IF RST == '1' THEN
      Q <= (others => '0');

    ELSE
    -- Falling edge
      IF falling_edge(Clk) THEN
        Q <= D;
      END IF;
    END IF;
    
END PROCESS;
END BEHAVIOR;