-- Library declaration
LIBRARY ieee ;
USE ieee.std_logic_1164.all;

LIBRARY SUB_SYSTEMS;
USE SUB_SYSTEMS.SUB_SYSTEMS.ALL;

-- Entity declaration
ENTITY MULTIPLIER IS
  GENERIC(
    N : natural :=4
    
  );
  
  PORT (
    A, B: IN std_logic_vector(N-1 DOWNTO 0);
    P : OUT std_logic_vector(2*N-1 DOWNTO 0)
    
  );
END ENTITY MULTIPLIER;


-- Architecture declaration
ARCHITECTURE ARCH_MULTIPLIER OF MULTIPLIER IS
  --DEFINE INTERMEDIATE SIGNALS
  SIGNAL C: std_logic_vector (N-1 DOWNTO 0); --Carry outs
  SIGNAL X: std_logic_vector (N*N -1 DOWNTO 0); -- Ands
  SIGNAL S: std_logic_vector ((N+1)*(N) -1 DOWNTO 0);
  

  BEGIN
    -- First carry in n-bit adder
    C(0) <= '0';

    -- All ands
    GEN_BASE_CASE_B: FOR i in 0 TO N-1 GENERATE
        GEN_BASE_CASE_A: FOR j in 0 TO N-1 GENERATE
            X(i*N + j) <= B(i) AND A(j);

        END GENERATE;

    END GENERATE;
    S(N-1 DOWNTO 0) <= X(N-1 DOWNTO 0);  
    S(N)<= C(0);
    P(0) <= S(0);
    
    
    -- Adders
    GEN_MULTIPLIERS: FOR i in 1 TO N-1 GENERATE

      FA: FULL_ADDER
        GENERIC MAP (N)
        PORT MAP(
            X(N-1 + i*N DOWNTO i*N), S(N + (i-1)*(N+1) DOWNTO 1 + (i-1)*(N+1)),
            '0',
            S(N + i*(N+1)-1 DOWNTO i*(N+1)),
            C(i)

        );

        S(N + i*(N+1))<=C(i);
        P(i) <= S(i*(N+1));

    END GENERATE; 

    P(2*N-1) <= C(N-1);
    P(2*N-2 DOWNTO 2*N-1-N+1) <= S((N+1)*(N) -1 DOWNTO (N+1)*(N)-N+1);
    
END ARCH_MULTIPLIER;