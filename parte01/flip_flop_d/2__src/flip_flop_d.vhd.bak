-- Library declaration
LIBRARY ieee ;
USE ieee.std_logic_1164.all ;

-- Entity declaration
ENTITY FLIP_FLOP_D IS
  PORT (
    T_FF: IN STD_LOGIC; -- Defines the edge type '0' --> falling, '1'--> rising
    D, Clk : IN STD_LOGIC ;
    Q : OUT STD_LOGIC
  );
END ENTITY FLIP_FLOP_D;


-- Architecture declaration
ARCHITECTURE BEHAVIOR OF FLIP_FLOP_D IS
BEGIN
PROCESS (T_FF, D, Clk )
  BEGIN
    -- Falling edge
    IF T_FF = '0' THEN
      IF falling_edge(Clk) THEN
        Q <= D;
      END IF;
    END IF;
    
    -- Rising_edge
    --IF T_FF = '1' THEN
     -- IF rising_edge(Clk) THEN
     --   Q <= D;
      --END IF;
    --END IF;
END PROCESS;
END BEHAVIOR;